# Every value is optional; these are the safe local defaults.
DISHLY_DATA_PATH=./data/recipes.json
DISHLY_INDEX_PATH=./data/embeddings.json
DISHLY_SERVICE_HOST=127.0.0.1
DISHLY_SERVICE_PORT=8000
# Optional for loopback/private-network use; required when the service crosses hosts.
# Generate at least 32 random characters and set the same value as
# RETRIEVAL_SERVICE_TOKEN on Express.
DISHLY_SERVICE_TOKEN=
DISHLY_AUTO_BUILD_INDEX=false

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_PARSER_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_CONNECT_TIMEOUT_SECONDS=1.5
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_PARSER_TIMEOUT_SECONDS=180
DISHLY_EMBEDDING_BATCH_SIZE=32
