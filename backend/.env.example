# Local backend configuration. The local-only RAG runtime needs no API key.
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Private Python recipe-retrieval service. Keep this URL server-side.
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8000
# Render and similar private networks can inject host:port separately instead.
RETRIEVAL_SERVICE_HOSTPORT=
# Set this to the same 32+ character secret as DISHLY_SERVICE_TOKEN whenever
# retrieval crosses a machine or trust boundary.
RETRIEVAL_SERVICE_TOKEN=
RETRIEVAL_TIMEOUT_MS=8000
# Cold local model inference can take longer on a Raspberry Pi.
GOAL_PARSER_TIMEOUT_MS=180000

# Production can provide either PostgreSQL or a durable local SQLite file.
# DATABASE_URL takes precedence when both variables are present.
DATABASE_URL=
SQLITE_DATABASE_PATH=
REQUIRE_PERSISTENT_STORE=false
