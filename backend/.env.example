# Local backend configuration template. Copy this file to .env before adding secrets.
PORT=3000
CORS_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_TIMEOUT_MS=90000
GEMINI_RETRY_ATTEMPTS=2

SPOONACULAR_API_KEY=
SPOONACULAR_TIMEOUT_MS=8000

# Optional, free Supabase account layer. Leave blank to run Dishly in guest-only mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only; needed only for the user-facing Delete account action.
SUPABASE_SECRET_KEY=
