[Unit]
Description=Dishly local parser and recipe retrieval
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=dishly
Group=dishly
WorkingDirectory=/opt/dishly/CU-Hack/dishly-addon
EnvironmentFile=-/opt/dishly/CU-Hack/dishly-addon/.env
ExecStart=/opt/dishly/CU-Hack/dishly-addon/.venv/bin/python -m dishly_retrieval serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
